			<array>
				<string>public.png</string>
				<string>public.jpeg</string>
				<string>public.tiff</string>
				<string>com.compuserve.gif</string>
				<string>public.heic</string>
				<string>public.heif</string>
				<string>org.webmproject.webp</string>
				<string>com.microsoft.bmp</string>
			</array>
		</dict>
	</array>
	<key>Privacy - Screen Capture Usage Description</key>
	<string>Snaploom needs screen recording permission to capture screenshots.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Snaploom can record microphone audio during screen recordings.</string>
	<key>NSCameraUsageDescription</key>
	<string>Snaploom can show a webcam overlay during screen recordings.</string>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/xiaoou-waou/Snaploom/main/appcast.xml</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
</dict>
</plist>
